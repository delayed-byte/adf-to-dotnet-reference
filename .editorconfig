root = true

[*]
charset = utf-8
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,csproj,props}]
indent_size = 2

[*.sql]
end_of_line = lf

[tests/**.cs]
# Underscored, sentence-style test names are intentional.
dotnet_diagnostic.CA1707.severity = none

[tests/TestData/generator/**.cs]
# Canonical-value helpers and column types are named after the SQL types they describe (Char, Decimal, Int).
dotnet_diagnostic.CA1720.severity = none
