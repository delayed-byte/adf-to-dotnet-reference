{
  "name": "PL_Reconciliation",
  "properties": {
    "description": "Card check (settlement totals vs KeyStone card transactions) and GL check (core.DailyGlTotals vs KeyStone GL entries) for the business date. Differences beyond the tolerance are written to ops.ReconExceptions and alerted once to the webhook; otherwise the run is recorded as Reconciled. ADF cannot nest an If Condition inside another, so exceptions are recorded first and the If decides only whether an alert is still due.",
    "activities": [
      {
        "name": "Log Recon Started",
        "type": "SqlServerStoredProcedure",
        "dependsOn": [],
        "policy": {
          "timeout": "0.00:05:00",
          "retry": 2,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "storedProcedureName": "[ops].[usp_LogBatchRunEvent]",
          "storedProcedureParameters": {
            "BatchRunId": { "value": { "value": "@pipeline().parameters.batchRunId", "type": "Expression" }, "type": "Guid" },
            "BusinessDate": { "value": { "value": "@pipeline().parameters.businessDate", "type": "Expression" }, "type": "String" },
            "PipelineName": { "value": { "value": "@pipeline().Pipeline", "type": "Expression" }, "type": "String" },
            "Status": { "value": "Started", "type": "String" },
            "StartedUtc": { "value": { "value": "@utcNow()", "type": "Expression" }, "type": "Datetime" }
          }
        },
        "linkedServiceName": {
          "referenceName": "LS_Reporting_Sql",
          "type": "LinkedServiceReference"
        }
      },
      {
        "name": "Lookup Card Totals",
        "type": "Lookup",
        "dependsOn": [
          { "activity": "Log Recon Started", "dependencyConditions": [ "Succeeded" ] }
        ],
        "policy": {
          "timeout": "0.00:05:00",
          "retry": 2,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "source": {
            "type": "AzureSqlSource",
            "sqlReaderStoredProcedureName": "[ops].[usp_GetCardReconTotals]",
            "storedProcedureParameters": {
              "BusinessDate": { "type": "String", "value": { "value": "@pipeline().parameters.businessDate", "type": "Expression" } },
              "Tolerance": { "type": "Decimal", "value": { "value": "@pipeline().parameters.tolerance", "type": "Expression" } }
            },
            "queryTimeout": "00:05:00",
            "partitionOption": "None"
          },
          "dataset": {
            "referenceName": "DS_Reporting_SqlTable",
            "type": "DatasetReference",
            "parameters": {
              "schemaName": "core",
              "tableName": "CardSettlement"
            }
          },
          "firstRowOnly": true
        }
      },
      {
        "name": "Lookup GL Totals",
        "type": "Lookup",
        "dependsOn": [
          { "activity": "Log Recon Started", "dependencyConditions": [ "Succeeded" ] }
        ],
        "policy": {
          "timeout": "0.00:05:00",
          "retry": 2,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "source": {
            "type": "AzureSqlSource",
            "sqlReaderStoredProcedureName": "[ops].[usp_GetGlReconTotals]",
            "storedProcedureParameters": {
              "BusinessDate": { "type": "String", "value": { "value": "@pipeline().parameters.businessDate", "type": "Expression" } },
              "Tolerance": { "type": "Decimal", "value": { "value": "@pipeline().parameters.tolerance", "type": "Expression" } }
            },
            "queryTimeout": "00:05:00",
            "partitionOption": "None"
          },
          "dataset": {
            "referenceName": "DS_Reporting_SqlTable",
            "type": "DatasetReference",
            "parameters": {
              "schemaName": "core",
              "tableName": "DailyGlTotals"
            }
          },
          "firstRowOnly": true
        }
      },
      {
        "name": "Record Recon Exceptions",
        "type": "Lookup",
        "description": "Runs ops.usp_RecordReconExceptions, which inserts any new out-of-tolerance items and returns whether an alert is still due.",
        "dependsOn": [
          { "activity": "Lookup Card Totals", "dependencyConditions": [ "Succeeded" ] },
          { "activity": "Lookup GL Totals", "dependencyConditions": [ "Succeeded" ] }
        ],
        "policy": {
          "timeout": "0.00:05:00",
          "retry": 2,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "source": {
            "type": "AzureSqlSource",
            "sqlReaderStoredProcedureName": "[ops].[usp_RecordReconExceptions]",
            "storedProcedureParameters": {
              "BusinessDate": { "type": "String", "value": { "value": "@pipeline().parameters.businessDate", "type": "Expression" } },
              "BatchRunId": { "type": "Guid", "value": { "value": "@pipeline().parameters.batchRunId", "type": "Expression" } },
              "Tolerance": { "type": "Decimal", "value": { "value": "@pipeline().parameters.tolerance", "type": "Expression" } }
            },
            "queryTimeout": "00:05:00",
            "partitionOption": "None"
          },
          "dataset": {
            "referenceName": "DS_Reporting_SqlTable",
            "type": "DatasetReference",
            "parameters": {
              "schemaName": "ops",
              "tableName": "ReconExceptions"
            }
          },
          "firstRowOnly": true
        }
      },
      {
        "name": "If Alert Required",
        "type": "IfCondition",
        "dependsOn": [
          { "activity": "Record Recon Exceptions", "dependencyConditions": [ "Succeeded" ] }
        ],
        "userProperties": [],
        "typeProperties": {
          "expression": {
            "value": "@equals(activity('Record Recon Exceptions').output.firstRow.AlertRequired, true)",
            "type": "Expression"
          },
          "ifTrueActivities": [
            {
              "name": "Get Alert Webhook Url",
              "type": "WebActivity",
              "description": "Reads the alert webhook URL (it embeds a token) from Key Vault with the factory's managed identity.",
              "dependsOn": [],
              "policy": {
                "timeout": "0.00:01:00",
                "retry": 2,
                "retryIntervalInSeconds": 30,
                "secureOutput": true,
                "secureInput": false
              },
              "userProperties": [],
              "typeProperties": {
                "method": "GET",
                "url": "https://kv-cu-batch-prod.vault.azure.net/secrets/recon-alert-webhook-url?api-version=7.4",
                "authentication": {
                  "type": "MSI",
                  "resource": "https://vault.azure.net"
                }
              }
            },
            {
              "name": "Post Recon Alert",
              "type": "WebActivity",
              "dependsOn": [
                { "activity": "Get Alert Webhook Url", "dependencyConditions": [ "Succeeded" ] }
              ],
              "policy": {
                "timeout": "0.00:02:00",
                "retry": 3,
                "retryIntervalInSeconds": 30,
                "secureOutput": false,
                "secureInput": true
              },
              "userProperties": [],
              "typeProperties": {
                "method": "POST",
                "url": {
                  "value": "@activity('Get Alert Webhook Url').output.value",
                  "type": "Expression"
                },
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": {
                  "value": "{\"type\":\"ReconciliationException\",\"businessDate\":\"@{pipeline().parameters.businessDate}\",\"batchRunId\":\"@{pipeline().parameters.batchRunId}\",\"cardDifference\":@{activity('Lookup Card Totals').output.firstRow.Difference},\"glItemsOutOfTolerance\":@{activity('Lookup GL Totals').output.firstRow.ItemsOutOfTolerance},\"exceptionCount\":@{activity('Record Recon Exceptions').output.firstRow.ExceptionCount},\"summary\":\"@{activity('Record Recon Exceptions').output.firstRow.AlertSummary}\"}",
                  "type": "Expression"
                },
                "httpRequestTimeout": "00:01:00"
              }
            },
            {
              "name": "Mark Recon Alert Sent",
              "type": "SqlServerStoredProcedure",
              "dependsOn": [
                { "activity": "Post Recon Alert", "dependencyConditions": [ "Succeeded" ] }
              ],
              "policy": {
                "timeout": "0.00:05:00",
                "retry": 2,
                "retryIntervalInSeconds": 30,
                "secureOutput": false,
                "secureInput": false
              },
              "userProperties": [],
              "typeProperties": {
                "storedProcedureName": "[ops].[usp_MarkReconAlertSent]",
                "storedProcedureParameters": {
                  "BusinessDate": { "value": { "value": "@pipeline().parameters.businessDate", "type": "Expression" }, "type": "String" },
                  "BatchRunId": { "value": { "value": "@pipeline().parameters.batchRunId", "type": "Expression" }, "type": "Guid" }
                }
              },
              "linkedServiceName": {
                "referenceName": "LS_Reporting_Sql",
                "type": "LinkedServiceReference"
              }
            }
          ],
          "ifFalseActivities": []
        }
      },
      {
        "name": "Log Recon Outcome",
        "type": "SqlServerStoredProcedure",
        "dependsOn": [
          { "activity": "If Alert Required", "dependencyConditions": [ "Succeeded" ] }
        ],
        "policy": {
          "timeout": "0.00:05:00",
          "retry": 2,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "storedProcedureName": "[ops].[usp_LogBatchRunEvent]",
          "storedProcedureParameters": {
            "BatchRunId": { "value": { "value": "@pipeline().parameters.batchRunId", "type": "Expression" }, "type": "Guid" },
            "BusinessDate": { "value": { "value": "@pipeline().parameters.businessDate", "type": "Expression" }, "type": "String" },
            "PipelineName": { "value": { "value": "@pipeline().Pipeline", "type": "Expression" }, "type": "String" },
            "Status": {
              "value": {
                "value": "@if(equals(activity('Record Recon Exceptions').output.firstRow.IsOutOfTolerance, true), 'Exceptions', 'Reconciled')",
                "type": "Expression"
              },
              "type": "String"
            },
            "RecordCount": { "value": { "value": "@activity('Record Recon Exceptions').output.firstRow.ExceptionCount", "type": "Expression" }, "type": "Int64" },
            "Notes": {
              "value": {
                "value": "@concat('card difference=', string(activity('Lookup Card Totals').output.firstRow.Difference), '; GL items out of tolerance=', string(activity('Lookup GL Totals').output.firstRow.ItemsOutOfTolerance), '; tolerance=', pipeline().parameters.tolerance)",
                "type": "Expression"
              },
              "type": "String"
            },
            "EndedUtc": { "value": { "value": "@utcNow()", "type": "Expression" }, "type": "Datetime" }
          }
        },
        "linkedServiceName": {
          "referenceName": "LS_Reporting_Sql",
          "type": "LinkedServiceReference"
        }
      }
    ],
    "parameters": {
      "businessDate": {
        "type": "string"
      },
      "batchRunId": {
        "type": "string"
      },
      "tolerance": {
        "type": "string",
        "defaultValue": "0.00"
      }
    },
    "folder": {
      "name": "NightlyBatch"
    },
    "annotations": []
  }
}
